<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ForZip.GUI.ViewModels"
             xmlns:interfaces="clr-namespace:ForZip.Core.Interfaces;assembly=ForZip.Core"
             x:Class="ForZip.GUI.Views.LogConsoleView"
             x:DataType="vm:LogConsoleViewModel">
  <!-- La bitácora: se abre y se cierra desde la barra de estado (botón "Bitácora"). -->
  <Border BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,1,0,0"
          Background="{DynamicResource LogBgBrush}"
          IsVisible="{Binding IsExpanded}">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="{DynamicResource LogHeaderBrush}"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,4">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <!-- Abrir la bitácora en una ventana aparte, como texto seleccionable. -->
            <Button Classes="ghost logAction" Click="OnPopOutClick" ToolTip.Tip="{Binding TooltipPopOut}">
              <Viewbox Width="17" Height="17"><Path Classes="icon" Data="{StaticResource IconPopOut}"/></Viewbox>
            </Button>
            <Button Classes="ghost logAction" Click="OnExportLogClick" ToolTip.Tip="{Binding TooltipExport}">
              <Viewbox Width="17" Height="17"><Path Classes="icon" Data="{StaticResource IconSave}"/></Viewbox>
            </Button>
            <Button Classes="ghost logAction" Command="{Binding ClearCommand}" ToolTip.Tip="{Binding TooltipClear}">
              <Viewbox Width="17" Height="17"><Path Classes="icon" Data="{StaticResource IconClose}"/></Viewbox>
            </Button>
          </StackPanel>
          <TextBlock Classes="overline" Text="{Binding Title}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Height="170">
        <ListBox ItemsSource="{Binding Entries}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="12,4"
                 SelectionMode="Multiple"
                 KeyDown="OnLogListKeyDown"
                 x:Name="LogList">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{Binding MenuCopySelected}" Click="OnCopySelectedClick"/>
              <MenuItem Header="{Binding MenuCopyAll}" Click="OnCopyAllClick"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="4,2"/>
              <Setter Property="MinHeight" Value="0"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="interfaces:LogEntry">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0"
                           Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}"
                           Foreground="{DynamicResource LogTimeBrush}"
                           FontFamily="{StaticResource PlexMono}"
                           FontSize="12" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Level, StringFormat='{}{0}:'}"
                           Width="72"
                           FontFamily="{StaticResource PlexMono}"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,8,0">
                  <TextBlock.Styles>
                    <Style Selector="TextBlock[Text='Info:']">
                      <Setter Property="Foreground" Value="{DynamicResource LogInfoBrush}"/>
                    </Style>
                    <Style Selector="TextBlock[Text='Success:']">
                      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                    </Style>
                    <Style Selector="TextBlock[Text='Warning:']">
                      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                    </Style>
                    <Style Selector="TextBlock[Text='Error:']">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                    </Style>
                  </TextBlock.Styles>
                </TextBlock>
                <!-- Errores y advertencias se pintan enteros: solo con la palabra del nivel en color,
                     una línea roja se perdía entre las grises. -->
                <TextBlock Grid.Column="2"
                           Text="{Binding Message}"
                           Classes.error="{Binding IsError}"
                           Classes.warning="{Binding IsWarning}"
                           FontFamily="{StaticResource PlexMono}"
                           FontSize="12"
                           TextWrapping="Wrap">
                  <!-- El color base va como estilo y no como atributo: un valor local les ganaría a los dos de abajo. -->
                  <TextBlock.Styles>
                    <Style Selector="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}"/>
                    </Style>
                    <Style Selector="TextBlock.error">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                    </Style>
                    <Style Selector="TextBlock.warning">
                      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                    </Style>
                  </TextBlock.Styles>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
  </Border>

  <UserControl.Styles>
    <Style Selector="Button.logAction">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
</UserControl>
