<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ForZip.GUI.ViewModels"
        x:Class="ForZip.GUI.Views.ShellVerifyWindow"
        x:DataType="vm:ShellVerifyViewModel"
        x:Name="Root"
        Title="{DynamicResource shell_verify_title}"
        Icon="avares://ForZip/Assets/ForZip.ico"
        Width="780" Height="600"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="{DynamicResource BgSecondaryBrush}">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
      <TextBlock Text="{Binding Heading}"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <Border Classes="callout warning" IsVisible="{Binding IsElevated}">
        <TextBlock Text="{Binding LabelElevated}" TextWrapping="Wrap" FontSize="12"/>
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="{Binding ButtonClose}" Padding="16,8" Click="OnCloseClick"/>
      <TextBlock Text="{Binding Summary}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="11" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Una ficha por archivo -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ShellVerifyItem">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10"
                    Background="{DynamicResource BgCardBrush}">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                  <SelectableTextBlock Text="{Binding FullPath}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" IsVisible="{Binding IsBusy}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- El veredicto, con los colores de la pantalla Verificar -->
                <Border Classes="verdict" IsVisible="{Binding Verify.HasResult}"
                        Classes.valid="{Binding Verify.IsValid}"
                        Classes.invalid="{Binding Verify.IsInvalid}"
                        Classes.doubt="{Binding !Verify.IsValid}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Classes="verdictBadge" Width="44" Height="44" CornerRadius="22"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                      <Panel>
                        <Viewbox Width="24" Height="24" IsVisible="{Binding Verify.IsValid}">
                          <Path Classes="icon onAccent" StrokeThickness="2.4" Data="{StaticResource IconCheck}"/>
                        </Viewbox>
                        <Viewbox Width="24" Height="24" IsVisible="{Binding Verify.IsInvalid}">
                          <Path Classes="icon onAccent" StrokeThickness="2.6" Data="{StaticResource IconCross}"/>
                        </Viewbox>
                        <Viewbox Width="24" Height="24" IsVisible="{Binding Verify.IsBadFormat}">
                          <Path Classes="icon verdictMark" StrokeThickness="2.6" Data="{StaticResource IconExclamation}"/>
                        </Viewbox>
                        <Viewbox Width="24" Height="24" IsVisible="{Binding Verify.IsInconclusive}">
                          <Path Classes="icon verdictMark" StrokeThickness="2.6" Data="{StaticResource IconExclamation}"/>
                        </Viewbox>
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Classes="verdictTitle" Text="{Binding Verify.LabelBadgeValid}" IsVisible="{Binding Verify.IsValid}"/>
                      <TextBlock Classes="verdictTitle" Text="{Binding Verify.LabelBadgeInvalid}" IsVisible="{Binding Verify.IsInvalid}"/>
                      <TextBlock Classes="verdictTitle" Text="{Binding Verify.LabelBadgeBadFormat}" IsVisible="{Binding Verify.IsBadFormat}"/>
                      <TextBlock Classes="verdictTitle" Text="{Binding Verify.LabelBadgeInconclusive}" IsVisible="{Binding Verify.IsInconclusive}"/>
                      <TextBlock Text="{Binding Verify.VerdictLead}" FontSize="13" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Sobre o paquete cifrado: la contraseña y "Verificar de nuevo" -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowPassword}">
                  <TextBlock Classes="label" Text="{Binding Verify.LabelSealedPassword}"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Classes="mono" FontSize="15" Width="320"
                             Text="{Binding Verify.SealedPassword}"
                             PasswordChar="{Binding Verify.PasswordCharDisplay}"
                             IsEnabled="{Binding !IsBusy}"
                             KeyDown="OnPasswordKeyDown"/>
                    <ToggleButton Classes="icon" IsChecked="{Binding Verify.IsPasswordVisible}"
                                  ToolTip.Tip="{Binding Verify.TooltipTogglePassword}">
                      <Viewbox Width="20" Height="20"><Path Classes="icon" Data="{StaticResource IconEye}"/></Viewbox>
                    </ToggleButton>
                    <Button Content="{Binding ButtonRetry}" IsEnabled="{Binding !IsBusy}" Padding="16,8"
                            Command="{Binding #Root.((vm:ShellVerifyViewModel)DataContext).RetryCommand}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                  <TextBlock Classes="hint" Text="{Binding Verify.LabelSealedPasswordHint}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Detalle: archivo por archivo, firma, sello de tiempo -->
                <Expander Header="{Binding LabelDetail}" IsExpanded="{Binding IsDetailExpanded}"
                          IsVisible="{Binding Verify.HasResult}" HorizontalAlignment="Stretch">
                  <SelectableTextBlock Text="{Binding Verify.DetailsText}"
                                       FontFamily="{StaticResource PlexMono}"
                                       FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Expander>

                <!-- Informe a pedido, con este veredicto al final -->
                <StackPanel Spacing="6" IsVisible="{Binding Verify.CanSaveReport}">
                  <Button Click="OnSaveReportClick" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Viewbox Width="18" Height="18"><Path Classes="icon" Data="{StaticResource IconReport}"/></Viewbox>
                      <TextBlock Text="{Binding Verify.LabelSaveReport}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Classes="hint" Text="{Binding Verify.ReportSavedNote}" TextWrapping="Wrap"
                             IsVisible="{Binding Verify.ReportSavedNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <Button Command="{Binding Verify.OpenSavedReportFolderCommand}" IsVisible="{Binding Verify.HasSavedReport}"
                          HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Viewbox Width="16" Height="16"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Viewbox>
                      <TextBlock Text="{Binding Verify.LabelOpenFolder}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

  <Window.Styles>
    <!-- El encabezado del Expander es un ToggleButton: sin esto le tocaba el violeta de "marcado" de App.axaml,
         y solo en el recuadro del texto (empezaba en la "D" de Detalle, no en el borde) -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.verdict">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border.verdict.doubt">
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
    </Style>
    <Style Selector="Border.verdict.doubt Border.verdictBadge">
      <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
    </Style>
    <Style Selector="Border.verdict.doubt TextBlock.verdictTitle">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
    </Style>
    <Style Selector="Border.verdict Path.verdictMark">
      <Setter Property="Stroke" Value="{DynamicResource OnWarningBrush}"/>
    </Style>
    <Style Selector="Border.verdict.valid">
      <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
    </Style>
    <Style Selector="Border.verdict.valid Border.verdictBadge">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    </Style>
    <Style Selector="Border.verdict.valid TextBlock.verdictTitle">
      <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
    </Style>
    <Style Selector="Border.verdict.invalid">
      <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}"/>
    </Style>
    <Style Selector="Border.verdict.invalid Border.verdictBadge">
      <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Border.verdict.invalid TextBlock.verdictTitle">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.verdictTitle">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>
</Window>
