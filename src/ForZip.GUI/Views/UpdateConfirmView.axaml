<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ForZip.GUI.Views.UpdateConfirmView"
        Title="ForZip"
        Icon="avares://ForZip/Assets/ForZip.ico"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        CanResize="False"
        Background="{DynamicResource BgSecondaryBrush}">

  <StackPanel Margin="24" Spacing="16">

    <TextBlock Name="TitleText"
               FontSize="18" FontWeight="Bold"
               Foreground="{DynamicResource AccentBrush}"
               TextWrapping="Wrap"/>

    <TextBlock Name="MessageText"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextPrimaryBrush}"/>

    <Border Background="{DynamicResource BgCardBrush}"
            CornerRadius="4"
            Padding="12">
      <TextBlock Name="StepsText"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Name="CancelButton"
              Padding="16,8"
              Click="OnCancelClick"/>
      <Button Classes="primary" Name="AcceptButton"
              Click="OnAcceptClick"/>
    </StackPanel>

  </StackPanel>
</Window>
