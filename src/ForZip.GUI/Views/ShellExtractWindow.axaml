<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ForZip.GUI.ViewModels"
        x:Class="ForZip.GUI.Views.ShellExtractWindow"
        x:DataType="vm:ShellExtractViewModel"
        x:Name="Root"
        Title="{DynamicResource shell_extract_title}"
        Icon="avares://ForZip/Assets/ForZip.ico"
        Width="760" Height="520"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="{DynamicResource BgSecondaryBrush}">

  <DockPanel Margin="20">

    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
      <TextBlock Text="{Binding Heading}"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <!-- Como en la ventana completa: elevado, el Explorador no le puede pasar archivos -->
      <Border Classes="callout warning" IsVisible="{Binding IsElevated}">
        <TextBlock Text="{Binding LabelElevated}" TextWrapping="Wrap" FontSize="12"/>
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="{Binding ButtonClose}" Padding="16,8" Click="OnCloseClick"/>
      <TextBlock Text="{Binding Summary}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="11" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Una ficha por archivo -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ShellExtractItem">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10"
                    Background="{DynamicResource BgCardBrush}">
              <StackPanel Spacing="8">

                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <SelectableTextBlock Text="{Binding DestinationText}" IsVisible="{Binding ShowDestination}"
                                     Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                     TextWrapping="Wrap"/>

                <!-- "Extraer…": el destino se confirma antes de extraer -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowDestinationEditor}">
                  <TextBlock Classes="label" Text="{Binding LabelDestination}"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Classes="mono" Text="{Binding Unzip.OutputDirectory}"/>
                    <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" Click="OnBrowseOutputClick"
                            ToolTip.Tip="{Binding LabelDestination}">
                      <Viewbox Width="20" Height="20"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Viewbox>
                    </Button>
                  </Grid>
                </StackPanel>

                <!-- Solo cuando el archivo resultó cifrado: la contraseña se pide ahí mismo -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowPasswordEditor}">
                  <TextBlock Classes="label" Text="{Binding LabelPassword}"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Classes="mono" FontSize="15" Width="340"
                             Text="{Binding Unzip.Password}"
                             PasswordChar="{Binding Unzip.PasswordCharDisplay}"
                             KeyDown="OnPasswordKeyDown"/>
                    <ToggleButton Classes="icon" IsChecked="{Binding Unzip.IsPasswordVisible}"
                                  ToolTip.Tip="{Binding Unzip.TooltipTogglePassword}">
                      <Viewbox Width="20" Height="20"><Path Classes="icon" Data="{StaticResource IconEye}"/></Viewbox>
                    </ToggleButton>
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding Unzip.IsProcessing}">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding Unzip.ProgressPercent}" Height="6"
                               Foreground="{DynamicResource ProgressFillBrush}"
                               Background="{DynamicResource ProgressBgBrush}"/>
                  <TextBlock Text="{Binding Unzip.ProgressFile}" Classes="mono" FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="PrefixCharacterEllipsis"
                             ToolTip.Tip="{Binding Unzip.ProgressFile}"
                             IsVisible="{Binding Unzip.ProgressFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <TextBlock Text="{Binding Unzip.ProgressDetail}" FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                             TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"
                             Classes="status" Classes.statusError="{Binding IsStatusError}" Margin="0,0,12,0"/>
                  <Button Grid.Column="1" Content="{Binding ButtonCancel}" IsVisible="{Binding ShowCancel}"
                          Padding="16,8"
                          Command="{Binding #Root.((vm:ShellExtractViewModel)DataContext).CancelCommand}"
                          CommandParameter="{Binding}"/>
                  <Button Grid.Column="2" Classes="primary" IsVisible="{Binding CanEdit}" Margin="8,0,0,0"
                          Command="{Binding #Root.((vm:ShellExtractViewModel)DataContext).StartCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Viewbox Width="18" Height="18"><Path Classes="icon" StrokeThickness="1.9" Data="{StaticResource IconExtract}"/></Viewbox>
                      <TextBlock Text="{Binding ButtonExtract}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- Resultado: el mismo de la pantalla Extraer, con cada observación a la vista -->
                <Border Classes="subtle resultCard" Padding="14,12" IsVisible="{Binding Unzip.HasResult}"
                        Classes.ok="{Binding Unzip.ResultKind, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=ok}"
                        Classes.notes="{Binding Unzip.ResultKind, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=notes}"
                        Classes.error="{Binding Unzip.ResultKind, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=error}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Grid.Column="0" Classes="resultBadge" Width="34" Height="34" CornerRadius="17"
                              Margin="0,0,12,0" VerticalAlignment="Center">
                        <Panel>
                          <Viewbox Width="18" Height="18" IsVisible="{Binding Unzip.ResultKind, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=ok}">
                            <Path Classes="icon success bold" Data="{StaticResource IconCheck}"/>
                          </Viewbox>
                          <Viewbox Width="18" Height="18" IsVisible="{Binding Unzip.ResultKind, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=notes}">
                            <Path Classes="icon warning" StrokeThickness="2" Data="{StaticResource IconWarning}"/>
                          </Viewbox>
                          <Viewbox Width="18" Height="18" IsVisible="{Binding Unzip.ResultKind, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=error}">
                            <Path Classes="icon error bold" Data="{StaticResource IconCross}"/>
                          </Viewbox>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Unzip.ResultHeading}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Unzip.ResultDetail}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <Button Grid.Column="2" Command="{Binding Unzip.OpenOutputFolderCommand}"
                              VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Viewbox Width="16" Height="16"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Viewbox>
                          <TextBlock Text="{Binding Unzip.LabelOpenFolder}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Unzip.Observations}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ExtractionObservation">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Classes.obsError="{Binding IsError}" Classes="obsTitle"/>
                            <TextBlock Text="{Binding Detail}" Classes="mono" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding Advice}" Classes="hint" IsVisible="{Binding HasAdvice}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

  <Window.Styles>
    <Style Selector="Border.resultCard.ok">
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
    </Style>
    <Style Selector="Border.resultCard.ok Border.resultBadge">
      <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
    </Style>
    <Style Selector="Border.resultCard.notes">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
    </Style>
    <Style Selector="Border.resultCard.notes Border.resultBadge">
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
    </Style>
    <Style Selector="Border.resultCard.error">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}"/>
    </Style>
    <Style Selector="Border.resultCard.error Border.resultBadge">
      <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.status.statusError">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.obsTitle">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.obsTitle.obsError">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
    </Style>
  </Window.Styles>
</Window>
