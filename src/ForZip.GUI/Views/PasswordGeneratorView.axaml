<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ForZip.GUI.ViewModels"
             x:Class="ForZip.GUI.Views.PasswordGeneratorView"
             x:DataType="vm:PasswordGeneratorViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Margin="32,28,32,28" MaxWidth="820">

      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="{Binding Heading}"/>
        <TextBlock Classes="lead" Text="{Binding Subtitle}"/>
      </StackPanel>

      <!-- La clave, grande y en letra de ancho fijo: se lee carácter por carácter. -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <Border Classes="subtle" Padding="18,14">
            <SelectableTextBlock Text="{Binding GeneratedPassword}"
                                 FontFamily="{StaticResource PlexMono}"
                                 FontSize="22"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
          </Border>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <ProgressBar Grid.Column="0" Minimum="0" Maximum="128"
                         Value="{Binding EntropyBits}"
                         Height="8" CornerRadius="4" VerticalAlignment="Center"
                         Foreground="{DynamicResource ProgressFillBrush}"
                         Background="{DynamicResource ProgressBgBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding EntropyLabel}"
                       Foreground="{DynamicResource AccentTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="14,0,6,0"/>
            <TextBlock Grid.Column="2" Text="{Binding EntropyBits, StringFormat='{}{0:0.0} bits'}"
                       Classes="hint" VerticalAlignment="Center"/>
          </Grid>

          <TextBlock Text="{Binding StatusMessage}" Classes="hint"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Command="{Binding CopyCommand}" MinHeight="46" Padding="18,10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Width="18" Height="18"><Path Classes="icon" Data="{StaticResource IconCopy}"/></Viewbox>
                <TextBlock Text="{Binding ButtonCopy}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="primary" Command="{Binding GenerateCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Viewbox Width="20" Height="20"><Path Classes="icon" StrokeThickness="1.9" Data="{StaticResource IconKey}"/></Viewbox>
                <TextBlock Text="{Binding ButtonGenerate}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{Binding LabelOptions}"/>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{Binding LabelLength}"/>
            <Grid ColumnDefinitions="*,Auto">
              <Slider Grid.Column="0" Minimum="{Binding MinLength}" Maximum="{Binding MaxLength}"
                      Value="{Binding Length}"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"/>
              <NumericUpDown Grid.Column="1"
                             Value="{Binding Length}"
                             Minimum="{Binding MinLength}"
                             Maximum="{Binding MaxLength}"
                             Increment="1"
                             FormatString="0"
                             ParsingNumberStyle="Integer"
                             Width="120"
                             Margin="14,0,0,0"
                             VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Classes="hint" Text="{Binding LabelMinLength}"/>
          </StackPanel>

          <WrapPanel Orientation="Horizontal">
            <CheckBox Content="{Binding LabelUppercase}" IsChecked="{Binding IncludeUppercase}" Margin="0,0,20,4"/>
            <CheckBox Content="{Binding LabelLowercase}" IsChecked="{Binding IncludeLowercase}" Margin="0,0,20,4"/>
            <CheckBox Content="{Binding LabelDigits}" IsChecked="{Binding IncludeDigits}" Margin="0,0,20,4"/>
            <CheckBox Content="{Binding LabelSymbols}" IsChecked="{Binding IncludeSymbols}" Margin="0,0,20,4"/>
          </WrapPanel>

          <Border Classes="subtle">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding LabelExcluded}"
                         FontFamily="{StaticResource PlexMono}"
                         FontSize="13"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Classes="hint" Text="{Binding LabelExcludedHint}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
