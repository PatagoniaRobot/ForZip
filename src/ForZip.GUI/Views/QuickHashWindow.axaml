<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ForZip.GUI.ViewModels"
        x:Class="ForZip.GUI.Views.QuickHashWindow"
        x:DataType="vm:QuickHashViewModel"
        Title="{DynamicResource quick_hash_title}"
        Icon="avares://ForZip/Assets/ForZip.ico"
        Width="760" Height="520"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="{DynamicResource BgSecondaryBrush}">

  <DockPanel Margin="20">

    <!-- Encabezado: título y selección de algoritmos -->
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
      <TextBlock Text="{Binding Heading}"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>

      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding LabelAlgorithms}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"/>
        <CheckBox Content="MD5" IsChecked="{Binding UseMd5}"/>
        <CheckBox Content="SHA-1" IsChecked="{Binding UseSha1}"/>
        <CheckBox Content="SHA-256" IsChecked="{Binding UseSha256}"/>
        <CheckBox Content="SHA-512" IsChecked="{Binding UseSha512}"/>
      </StackPanel>
    </StackPanel>

    <!-- Pie: progreso, estado y acciones -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
      <ProgressBar Minimum="0" Maximum="100"
                   Value="{Binding ProgressPercent}"
                   IsVisible="{Binding IsProcessing}"
                   Height="6"
                   Foreground="{DynamicResource ProgressFillBrush}"
                   Background="{DynamicResource ProgressBgBrush}"/>

      <DockPanel>
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding Summary}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextAlignment="Right"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"/>
      </DockPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{Binding ButtonClose}"
                Padding="16,8"
                Click="OnCloseClick"/>
        <Button Content="{Binding ButtonExport}"
                Padding="16,8"
                IsEnabled="{Binding HasResults}"
                Click="OnExportClick"/>
        <Button Content="{Binding ButtonCopy}"
                Padding="16,8"
                IsEnabled="{Binding HasResults}"
                Background="{DynamicResource AccentBrush}"
                Foreground="White"
                Command="{Binding CopyCommand}"/>
      </StackPanel>
    </StackPanel>

    <!-- Una ficha por archivo -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuickHashItem">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14"
                    Margin="0,0,0,10"
                    Background="{DynamicResource BgCardBrush}">
              <StackPanel Spacing="6">

                <TextBlock Text="{Binding FileName}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>

                <SelectableTextBlock Text="{Binding FullPath}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontSize="11"
                                     TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock Text="{Binding SizeText}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11"/>
                  <TextBlock Text="{Binding ModifiedText}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           IsVisible="{Binding HasError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>

                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickHashLine">
                      <DockPanel Margin="0,0,0,3">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Algorithm}"
                                   Width="72"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="{Binding Value}"
                                             FontFamily="Consolas,monospace"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="Wrap"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>
</Window>
