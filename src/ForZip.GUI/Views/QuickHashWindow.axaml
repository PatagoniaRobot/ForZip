<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ForZip.GUI.ViewModels"
        x:Class="ForZip.GUI.Views.QuickHashWindow"
        x:DataType="vm:QuickHashViewModel"
        Title="{DynamicResource quick_hash_title}"
        Icon="avares://ForZip/Assets/ForZip.ico"
        Width="760" Height="520"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="{DynamicResource BgSecondaryBrush}">

  <DockPanel Margin="20">

    <!-- Encabezado: título y selección de algoritmos -->
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
      <TextBlock Text="{Binding Heading}"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>

      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding LabelAlgorithms}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"/>
        <!-- Deshabilitados durante el cálculo: cambiar el lote a mitad de camino confunde -->
        <CheckBox Content="MD5" IsChecked="{Binding UseMd5}" IsEnabled="{Binding CanEditAlgorithms}"/>
        <CheckBox Content="SHA-1" IsChecked="{Binding UseSha1}" IsEnabled="{Binding CanEditAlgorithms}"/>
        <CheckBox Content="SHA-256" IsChecked="{Binding UseSha256}" IsEnabled="{Binding CanEditAlgorithms}"/>
        <CheckBox Content="SHA-512" IsChecked="{Binding UseSha512}" IsEnabled="{Binding CanEditAlgorithms}"/>
      </StackPanel>
    </StackPanel>

    <!-- Pie: progreso, estado y acciones -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
      <!-- Progreso global del lote: avanza por bytes leídos, no de a un archivo entero -->
      <StackPanel Spacing="4" IsVisible="{Binding IsProcessing}">
        <ProgressBar Minimum="0" Maximum="100"
                     Value="{Binding ProgressPercent}"
                     Height="6"
                     Foreground="{DynamicResource ProgressFillBrush}"
                     Background="{DynamicResource ProgressBgBrush}"/>
        <TextBlock Text="{Binding ProgressDetail}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>

      <DockPanel>
        <TextBlock DockPanel.Dock="Left"
                   Text="{Binding Summary}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextAlignment="Right"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"/>
      </DockPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{Binding ButtonClose}"
                Padding="16,8"
                Click="OnCloseClick"/>
        <Button Content="{Binding ButtonExport}"
                Padding="16,8"
                IsEnabled="{Binding HasResults}"
                Click="OnExportClick"/>
        <Button Content="{Binding ButtonCopy}"
                Padding="16,8"
                IsEnabled="{Binding HasResults}"
                Command="{Binding CopyCommand}"/>

        <!-- Calcular y Cancelar ocupan el mismo lugar: nunca hacen falta los dos a la vez -->
        <Button Classes="primary" Content="{Binding ButtonCalculate}"
                IsVisible="{Binding !IsProcessing}"
                Command="{Binding CalculateCommand}"/>
        <Button Content="{Binding ButtonCancel}"
                Padding="16,8"
                IsVisible="{Binding IsProcessing}"
                Command="{Binding CancelCommand}"/>
      </StackPanel>
    </StackPanel>

    <!-- Una ficha por carpeta (su huella) y una por archivo -->
    <ScrollViewer>
      <StackPanel>
      <TextBlock Text="{Binding FolderNotice}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                 Foreground="{DynamicResource WarningTextBrush}"
                 IsVisible="{Binding FolderNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ItemsControl ItemsSource="{Binding FolderDigests}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FolderDigestItem">
            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="14"
                    Margin="0,0,0,10" Background="{DynamicResource BgCardBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <SelectableTextBlock Text="{Binding FolderPath}" FontSize="11" TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Spacing="3" Margin="0,4,0,0" IsVisible="{Binding HasDigest}">
                  <TextBlock Text="{Binding LabelForZip}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}"/>
                  <SelectableTextBlock Text="{Binding ForZip}" FontFamily="{StaticResource PlexMono}" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock Text="{Binding LabelSevenZip}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"
                             Foreground="{DynamicResource AccentBrush}"/>
                  <SelectableTextBlock Text="{Binding SevenZip}" FontFamily="{StaticResource PlexMono}" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasNote}"
                           Foreground="{DynamicResource WarningTextBrush}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuickHashItem">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14"
                    Margin="0,0,0,10"
                    Background="{DynamicResource BgCardBrush}">
              <StackPanel Spacing="6">

                <TextBlock Text="{Binding FileName}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>

                <SelectableTextBlock Text="{Binding FullPath}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontSize="11"
                                     TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock Text="{Binding SizeText}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11"/>
                  <TextBlock Text="{Binding ModifiedText}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorText}"
                           IsVisible="{Binding HasError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>

                <!-- "Pendiente" antes de calcular, "Calculando… N %" durante -->
                <TextBlock Text="{Binding StatusText}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"/>

                <ProgressBar Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent}"
                             IsVisible="{Binding IsProcessing}"
                             Height="4"
                             Foreground="{DynamicResource ProgressFillBrush}"
                             Background="{DynamicResource ProgressBgBrush}"/>

                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickHashLine">
                      <DockPanel Margin="0,0,0,3">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Algorithm}"
                                   Width="72"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <SelectableTextBlock Text="{Binding Value}"
                                             FontFamily="{StaticResource PlexMono}"
                                             FontSize="12"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="Wrap"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
