<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ForZip.GUI.ViewModels"
             x:Class="ForZip.GUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="32,28,32,28" MaxWidth="900">

      <TextBlock Classes="h1" Text="{Binding Title}"/>

      <TabControl>
        <TabItem Header="{Binding TabGeneral}">
          <StackPanel Spacing="16" Margin="8,16,8,8">
            <!-- Tema: dos tarjetas con una miniatura de cada uno. Se aplica y se guarda al instante. -->
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="{Binding LabelTheme}"/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <RadioButton Theme="{StaticResource CardRadio}" GroupName="ThemeGroup" Width="200"
                             IsChecked="{Binding Theme, ConverterParameter=light, Converter={x:Static vm:ThemeRadioConverter.Instance}}">
                  <StackPanel Spacing="10">
                    <Border Height="70" CornerRadius="8" Background="#F4F5F7" BorderBrush="#DDE1E6" BorderThickness="1" ClipToBounds="True">
                      <Grid ColumnDefinitions="44,*">
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DDE1E6" BorderThickness="0,0,1,0"/>
                        <StackPanel Grid.Column="1" Margin="10" Spacing="6">
                          <Border Height="8" Width="70" CornerRadius="4" Background="#15202B" HorizontalAlignment="Left"/>
                          <Border Height="26" CornerRadius="5" Background="#FFFFFF" BorderBrush="#DDE1E6" BorderThickness="1"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="34" Height="12" CornerRadius="4" Background="#0B6E6E"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"/>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding LabelThemeLight}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton Theme="{StaticResource CardRadio}" GroupName="ThemeGroup" Width="200"
                             IsChecked="{Binding Theme, ConverterParameter=dark, Converter={x:Static vm:ThemeRadioConverter.Instance}}">
                  <StackPanel Spacing="10">
                    <Border Height="70" CornerRadius="8" Background="#0F171F" BorderBrush="#2A3744" BorderThickness="1" ClipToBounds="True">
                      <Grid ColumnDefinitions="44,*">
                        <Border Grid.Column="0" Background="#131D26" BorderBrush="#2A3744" BorderThickness="0,0,1,0"/>
                        <StackPanel Grid.Column="1" Margin="10" Spacing="6">
                          <Border Height="8" Width="70" CornerRadius="4" Background="#E6EBF0" HorizontalAlignment="Left"/>
                          <Border Height="26" CornerRadius="5" Background="#17212B" BorderBrush="#2A3744" BorderThickness="1"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="34" Height="12" CornerRadius="4" Background="#0E7C76"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"/>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding LabelThemeDark}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </StackPanel>

            <DockPanel>
              <TextBlock Text="{Binding LabelLanguage}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"
                         Width="180"/>
              <ComboBox ItemsSource="{Binding AvailableLanguages}"
                        SelectedItem="{Binding Language}"
                        Width="200"
                        HorizontalAlignment="Left"/>
            </DockPanel>

            <DockPanel>
              <TextBlock DockPanel.Dock="Top"
                         Text="{Binding LabelOutputDir}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,0,0,4"/>
              <Button DockPanel.Dock="Right"
                      Content="..."
                      Click="OnBrowseOutputClick"
                      Width="40"
                      Margin="6,0,0,0"/>
              <TextBox Text="{Binding OutputDirectory}"/>
            </DockPanel>

            <StackPanel Spacing="4" Margin="0,8,0,0">
              <CheckBox Content="{Binding LabelCheckUpdates}"
                        IsChecked="{Binding CheckForUpdatesOnStartup}"/>
              <TextBlock Text="{Binding LabelCheckUpdatesHint}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="26,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </TabItem>

        <TabItem Header="{Binding TabOperator}">
          <StackPanel Spacing="10" Margin="8">
            <TextBlock Text="Estos datos se incluyen en los informes forenses."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"/>
            <TextBlock Text="Todos los campos son opcionales."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,8"/>

            <DockPanel>
              <TextBlock Text="Nombre:" Width="120"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBox Text="{Binding OperatorName}"/>
            </DockPanel>
            <DockPanel>
              <TextBlock Text="Cargo:" Width="120"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBox Text="{Binding OperatorTitle}"/>
            </DockPanel>
            <DockPanel>
              <TextBlock Text="Organismo:" Width="120"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBox Text="{Binding OperatorOrganization}"/>
            </DockPanel>
            <DockPanel>
              <TextBlock Text="Email:" Width="120"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBox Text="{Binding OperatorEmail}"/>
            </DockPanel>
            <DockPanel>
              <TextBlock Text="Teléfono:" Width="120"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBox Text="{Binding OperatorPhone}"/>
            </DockPanel>
          </StackPanel>
        </TabItem>

        <TabItem Header="{Binding TabDefaults}">
          <StackPanel Spacing="12" Margin="8">
            <TextBlock Text="Estos valores se pre-cargan en cada operación."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"/>

            <DockPanel>
              <TextBlock Text="Nivel de compresión:"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"
                         Width="220"/>
              <ComboBox ItemsSource="{Binding AvailableLevels}"
                        SelectedItem="{Binding DefaultCompressionLevel}"
                        Width="120"
                        HorizontalAlignment="Left"/>
            </DockPanel>

            <DockPanel>
              <TextBlock Text="Algoritmos de hash por defecto:"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"
                         Width="220"/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox Content="MD5" IsChecked="{Binding DefaultUseMd5}"/>
                <CheckBox Content="SHA-1" IsChecked="{Binding DefaultUseSha1}"/>
                <CheckBox Content="SHA-256" IsChecked="{Binding DefaultUseSha256}"/>
                <CheckBox Content="SHA-512" IsChecked="{Binding DefaultUseSha512}"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </TabItem>

        <TabItem Header="{Binding TabTrust}">
          <StackPanel Spacing="10" Margin="8">
            <TextBlock Text="{Binding LabelTrustDesc}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding LabelNoSigners}"
                       IsVisible="{Binding HasNoSigners}"
                       Foreground="{DynamicResource WarningBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <ItemsControl ItemsSource="{Binding TrustedSigners}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrustedSignerItem">
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Display}" FontFamily="{StaticResource PlexMono}" FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <!-- La X va en su propio TextBlock centrado, como en la lista de Empaquetar: como
                           Content suelto, la plantilla del botón la dejaba arriba a la izquierda. -->
                      <Button Grid.Column="1" Width="34" Height="34" MinHeight="0" Padding="0"
                              Classes="ghost" VerticalAlignment="Center"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveTrustedSignerCommand}"
                              CommandParameter="{Binding}">
                        <Viewbox Width="16" Height="16"><Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconClose}"/></Viewbox>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel>
              <TextBlock Text="{Binding LabelSignerName}" Width="120"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBox Text="{Binding NewSignerName}"/>
            </DockPanel>
            <DockPanel>
              <TextBlock Text="{Binding LabelSignerThumbprint}" Width="120"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"/>
              <TextBox Text="{Binding NewSignerThumbprint}" FontFamily="{StaticResource PlexMono}"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding ButtonFromCertificate}" Click="OnPickCertificateClick" Padding="16,8"/>
              <Button Classes="primary" Content="{Binding ButtonAddSigner}"
                      Command="{Binding AddTrustedSignerCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding TrustStatusMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </TabItem>

        <TabItem Header="{Binding TabShell}">
          <StackPanel Spacing="12" Margin="8">
            <TextBlock Text="{Binding LabelShellTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding LabelShellDesc}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding IsShellSupported}">
              <Button Classes="primary" Content="{Binding ButtonShellEnable}"
                      Command="{Binding EnableShellIntegrationCommand}"/>
              <Button Content="{Binding ButtonShellDisable}"
                      Command="{Binding DisableShellIntegrationCommand}"
                      IsEnabled="{Binding IsShellRegistered}"
                      Padding="16,8"/>
            </StackPanel>

            <TextBlock Text="{Binding ShellStatusMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </TabItem>
      </TabControl>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{DynamicResource AccentBrush}"
                 HorizontalAlignment="Center"/>

      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Center">
        <Button Classes="primary" Content="{Binding ButtonSave}"
                Command="{Binding SaveCommand}"/>
        <Button Content="{Binding ButtonReset}"
                Command="{Binding ResetDefaultsCommand}"
                Padding="20,8"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
