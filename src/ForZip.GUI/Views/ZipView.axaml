<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ForZip.GUI.ViewModels"
             x:Class="ForZip.GUI.Views.ZipView"
             x:DataType="vm:ZipViewModel"
             DragDrop.AllowDrop="True">

  <Panel>

    <!-- ================== PANTALLA DE RESULTADO ================== -->
    <ScrollViewer IsVisible="{Binding IsResultVisible}" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20" Margin="32,28,32,28" MaxWidth="920">

        <!-- Lo que pasó, grande y en verde: se entiende sin leer. -->
        <Border Classes="callout" Background="{DynamicResource SuccessSoftBrush}"
                BorderBrush="{DynamicResource SuccessBorderBrush}" Padding="26">
          <Grid ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32"
                    Background="{DynamicResource SuccessBrush}" VerticalAlignment="Top" Margin="0,0,20,0">
              <Viewbox Width="34" Height="34"><Path Classes="icon onAccent" StrokeThickness="2.4" Data="{StaticResource IconCheck}"/></Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding ResultTitle}" FontSize="24" FontWeight="SemiBold"
                         Foreground="{DynamicResource SuccessTextBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ResultSubtitle}" FontSize="15" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Paquete incompleto: el antivirus no dejó leer parte de la evidencia. -->
        <Border Classes="callout warning"
                IsVisible="{Binding ResultIncompleteNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ResultIncompleteNote}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
        <Border Classes="callout warning"
                IsVisible="{Binding ResultNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ResultNote}" TextWrapping="Wrap"/>
        </Border>
        <!-- Perfil Reservado: sin la clave el contenido no lo recupera nadie. -->
        <Border Classes="callout warning" IsVisible="{Binding IsSealedResultVisible}">
          <TextBlock Text="{Binding LabelIrrecoverableWarning}" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <!-- Lo que quedó en disco, cada archivo con su explicación. -->
        <Border Classes="card" Padding="8">
          <ItemsControl ItemsSource="{Binding ResultArtifacts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ResultArtifactItem">
                <Grid ColumnDefinitions="Auto,*" Margin="12,10">
                  <Border Grid.Column="0" Classes="iconTile" Width="40" Height="40" CornerRadius="10"
                          VerticalAlignment="Top" Margin="0,0,14,0">
                    <Viewbox Width="22" Height="22"><Path Classes="icon accent" Data="{Binding IconGeometry}"/></Viewbox>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Classes="mono" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" Classes="hint"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- ================== ACTA DE ENTREGA DE CLAVE ==================
             Se muestra en pantalla para poder dictarla o transcribirla. NO se guarda
             sola en disco: lleva la contraseña en claro y su destino es el papel. -->
        <Border Classes="card" IsVisible="{Binding IsSealedResultVisible}"
                BorderBrush="{DynamicResource WarningBorderBrush}">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{Binding LabelDeliveryAct}"/>
            <TextBlock Classes="hint" Text="{Binding DeliveryActHint}"/>
            <Border Classes="subtle">
              <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding DeliveryActText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="{StaticResource PlexMono}"
                         FontSize="13"
                         BorderThickness="0"
                         Background="Transparent"/>
              </ScrollViewer>
            </Border>
            <TextBlock Text="{Binding LabelActSaveWarning}" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource WarningTextBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="{Binding LabelCopyAct}" Command="{Binding CopyDeliveryActCommand}"/>
              <Button Content="{Binding LabelSaveAct}" Click="OnSaveDeliveryActClick"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="6"
                    IsVisible="{Binding ResultZipHash, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Classes="label" Text="{Binding LabelResultHash}"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Classes="mono" Text="{Binding ResultZipHash}" IsReadOnly="True"/>
            <Button Grid.Column="1" Content="{Binding LabelCopyHash}" Command="{Binding CopyResultHashCommand}"
                    Margin="8,0,0,0"/>
          </Grid>
          <!-- Lo que de verdad prueba que nadie tocó el paquete: esta huella anotada fuera de ForZip. -->
          <TextBlock Classes="hint" Text="{Binding LabelResultHashHint}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- El informe en texto ya no se escribe solo: se guarda a pedido, para imprimir o adjuntar. -->
        <StackPanel Spacing="6" IsVisible="{Binding CanSaveReport}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Click="OnSaveReportClick">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Viewbox Width="18" Height="18"><Path Classes="icon" Data="{StaticResource IconReport}"/></Viewbox>
                <TextBlock Text="{Binding LabelSaveReport}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="hint" Text="{Binding LabelSaveReportHint}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Command="{Binding OpenResultFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Viewbox Width="20" Height="20"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Viewbox>
              <TextBlock Text="{Binding LabelOpenFolder}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Content="{Binding LabelNewJob}" Command="{Binding NewJobCommand}" MinHeight="46" Padding="20,10"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ================== FORMULARIO DE EMPAQUETADO ==================
         Tres pasos numerados: la evidencia a la izquierda (su lista es lo único que crece),
         cómo protegerla y dónde guardarla a la derecha, y una barra de acción al pie con
         el resumen y el único botón principal de la pantalla, que nunca se va de la vista. -->
    <DockPanel IsVisible="{Binding !IsResultVisible}">

      <!-- Barra de acción -->
      <Border DockPanel.Dock="Bottom"
              Background="{DynamicResource BgSecondaryBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="32,14">
        <StackPanel Spacing="10">
          <!-- Carpeta sincronizada: describe el destino. La detección es heurística: avisa sin bloquear. -->
          <Border Classes="callout warning"
                  IsVisible="{Binding CloudSyncWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding CloudSyncWarning}" TextWrapping="Wrap" FontSize="13"/>
          </Border>

          <ProgressBar Minimum="0" Maximum="100"
                       Value="{Binding ProgressPercent}"
                       Height="8" CornerRadius="4"
                       IsVisible="{Binding IsProcessing}"
                       Foreground="{DynamicResource ProgressFillBrush}"
                       Background="{DynamicResource ProgressBgBrush}"/>

          <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsProcessing}">
            <TextBlock Grid.Column="0" Text="{Binding ProgressDetail}" Classes="hint"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0">
              <TextBlock Text="{Binding LabelElapsed}" Classes="hint"/>
              <TextBlock Text="{Binding ElapsedTime}" Classes="mono" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding LabelRemaining}" Classes="hint"/>
              <TextBlock Text="{Binding RemainingTime}" Classes="mono" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Button Grid.Column="1" Content="{Binding ButtonCancel}" Command="{Binding CompressCancelCommand}"
                    IsVisible="{Binding IsProcessing}" MinHeight="46" Padding="20,10" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Classes="primary" Command="{Binding CompressCommand}"
                    IsEnabled="{Binding CanStartCompress}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Viewbox Width="20" Height="20"><Path Classes="icon" StrokeThickness="1.9" Data="{StaticResource IconPackage}"/></Viewbox>
                <TextBlock Text="{Binding ButtonPack}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Encabezado: título y modo -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="32,28,32,0">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Classes="h1" Text="{Binding Heading}"/>
          <TextBlock Classes="lead" Text="{Binding Subtitle}"/>
        </StackPanel>
        <Border Grid.Column="1" Classes="segmentTrack" VerticalAlignment="Center" Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton Theme="{StaticResource SegmentRadio}" GroupName="ZipMode"
                         Content="{Binding LabelModeSimple}" IsChecked="{Binding IsSimpleMode}"/>
            <RadioButton Theme="{StaticResource SegmentRadio}" GroupName="ZipMode"
                         Content="{Binding LabelModeAdvanced}" IsChecked="{Binding !IsSimpleMode}"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,20,*" Margin="32,20,32,20">

        <!-- ========== Paso 1: la evidencia ========== -->
        <Border Grid.Column="0" Classes="card">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Classes="stepHeader">
              <Border Classes="step"><TextBlock Text="1"/></Border>
              <TextBlock Classes="h2" Text="{Binding LabelStepWhat}" VerticalAlignment="Center"/>
            </StackPanel>

            <Panel DockPanel.Dock="Top" Margin="0,14,0,0">
              <Rectangle Stroke="{DynamicResource DashedBorderBrush}" StrokeThickness="1.5"
                         StrokeDashArray="4,3" RadiusX="12" RadiusY="12"/>
              <Border x:Name="DropZone"
                      Background="{DynamicResource BgSubtleBrush}"
                      CornerRadius="12" Margin="1.5" Padding="16,18">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                  <Viewbox Width="28" Height="28" HorizontalAlignment="Center"><Path Classes="icon" Data="{StaticResource IconDrop}"/></Viewbox>
                  <TextBlock Text="{Binding LabelDropZone}" FontSize="14"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Button x:Name="BrowseFilesButton" Content="{Binding LabelBrowseFiles}" Click="OnBrowseFilesClick"/>
                    <Button x:Name="BrowseFolderButton" Content="{Binding LabelBrowseFolder}" Click="OnBrowseFolderClick"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Panel>

            <DockPanel DockPanel.Dock="Top" Margin="0,14,0,8">
              <Button DockPanel.Dock="Right" Classes="link" Content="{Binding ButtonClear}"
                      Command="{Binding ClearAllCommand}"/>
              <TextBlock Text="{Binding LabelFilesCount}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- La lista se queda con todo el alto que sobre y es lo único que scrollea. -->
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    CornerRadius="10" MinHeight="80">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Files}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SelectedFileItem">
                      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Panel>
                              <Path Classes="icon accent" Data="{StaticResource IconFolder}" IsVisible="{Binding IsFolder}"/>
                              <Path Classes="icon" Data="{StaticResource IconFile}" IsVisible="{Binding !IsFolder}"/>
                            </Panel>
                          </Viewbox>
                          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" Classes="hint"
                                     VerticalAlignment="Center" Margin="8,0"/>
                          <Button Grid.Column="3" Classes="ghost icon" Width="34" Height="34"
                                  Command="{Binding $parent[ItemsControl].((vm:ZipViewModel)DataContext).RemoveFileCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ZipViewModel)DataContext).TooltipRemoveFile}">
                            <Viewbox Width="16" Height="16"><Path Classes="icon" StrokeThickness="2" Data="{StaticResource IconClose}"/></Viewbox>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </Border>

        <!-- ========== Pasos 2 y 3 ========== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="20">

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Classes="stepHeader">
                  <Border Classes="step"><TextBlock Text="2"/></Border>
                  <TextBlock Classes="h2" Text="{Binding LabelStepProtect}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Perfil: dos tarjetas que explican cada opción. -->
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="{Binding LabelProfile}"/>
                  <Grid ColumnDefinitions="*,10,*">
                    <RadioButton Grid.Column="0" Theme="{StaticResource CardRadio}" GroupName="Profile"
                                 IsChecked="{Binding !IsReservedProfile}" ToolTip.Tip="{Binding LabelProfileStandard}">
                      <StackPanel Spacing="6">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Left"><Path Classes="icon profileIcon" Data="{StaticResource IconPackage}"/></Viewbox>
                        <TextBlock Text="{Binding LabelProfileStandardName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ProfileStandardDesc}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2" Theme="{StaticResource CardRadio}" GroupName="Profile"
                                 IsChecked="{Binding IsReservedProfile}" ToolTip.Tip="{Binding LabelProfileReserved}">
                      <StackPanel Spacing="6">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Left"><Path Classes="icon profileIcon" Data="{StaticResource IconEnvelope}"/></Viewbox>
                        <TextBlock Text="{Binding LabelProfileReservedName}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ProfileReservedDesc}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </RadioButton>
                  </Grid>
                  <TextBlock Classes="hint" Text="{Binding ProfileHint}"/>
                </StackPanel>

                <!-- Aviso del perfil Estándar: discreto, no bloqueante, y una sola vez por sesión.
                     Una advertencia que aparece siempre se vuelve invisible. -->
                <Border Classes="callout warning" IsVisible="{Binding IsStandardNoticeVisible}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding LabelStandardNotice}" TextWrapping="Wrap" FontSize="13"/>
                    <Button Command="{Binding DismissStandardNoticeCommand}" Content="{Binding LabelDismissNotice}"
                            HorizontalAlignment="Right"/>
                  </StackPanel>
                </Border>

                <Separator Background="{DynamicResource DividerBrush}" Margin="0"/>

                <!-- Cifrado: disponible en ambos modos -->
                <StackPanel Spacing="10">
                  <CheckBox Content="{Binding LabelEncryption}"
                            FontSize="15"
                            IsChecked="{Binding IsEncryptionEnabled}"
                            IsEnabled="{Binding AreProfileGovernedControlsEnabled}"
                            ToolTip.Tip="{Binding TooltipProfileLocked}"/>
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding IsEncryptionEnabled}">
                    <TextBox Grid.Column="0"
                             Classes="mono"
                             FontSize="15"
                             Text="{Binding Password}"
                             PasswordChar="{Binding PasswordCharDisplay}"
                             IsReadOnly="{Binding IsReservedProfile}"
                             Watermark="{Binding LabelPasswordPlaceholder}"
                             ToolTip.Tip="{Binding TooltipProfileLocked}"/>
                    <ToggleButton Grid.Column="1" Classes="icon" Margin="8,0,0,0"
                                  IsChecked="{Binding IsPasswordVisible}"
                                  ToolTip.Tip="{Binding TooltipTogglePassword}">
                      <Viewbox Width="20" Height="20"><Path Classes="icon" Data="{StaticResource IconEye}"/></Viewbox>
                    </ToggleButton>
                    <Button Grid.Column="2" Classes="icon" Margin="8,0,0,0"
                            Command="{Binding CopyPasswordCommand}"
                            ToolTip.Tip="{Binding TooltipCopyPassword}">
                      <Viewbox Width="20" Height="20"><Path Classes="icon" Data="{StaticResource IconCopy}"/></Viewbox>
                    </Button>
                    <Button Grid.Column="3" Classes="icon" Margin="8,0,0,0"
                            Command="{Binding GeneratePasswordCommand}"
                            ToolTip.Tip="{Binding TooltipGeneratePassword}">
                      <Viewbox Width="20" Height="20"><Path Classes="icon" Data="{StaticResource IconKey}"/></Viewbox>
                    </Button>
                  </Grid>
                </StackPanel>

                <!-- Formato: disponible en ambos modos; el perfil Reservado lo fija en ZIP
                     (es lo que lleva el sobre). -->
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="{Binding LabelFormat}"/>
                  <Border Classes="segmentTrack" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Theme="{StaticResource SegmentRadio}" GroupName="ArchiveFormat"
                                   Content="{Binding LabelFormatZip}" IsChecked="{Binding IsZipFormat}"
                                   IsEnabled="{Binding AreProfileGovernedControlsEnabled}"
                                   ToolTip.Tip="{Binding TooltipProfileLocked}"/>
                      <RadioButton Theme="{StaticResource SegmentRadio}" GroupName="ArchiveFormat"
                                   Content="{Binding LabelFormat7z}" IsChecked="{Binding Is7zFormat}"
                                   IsEnabled="{Binding AreProfileGovernedControlsEnabled}"
                                   ToolTip.Tip="{Binding TooltipProfileLocked}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Classes="hint" Text="{Binding FormatHint}"/>
                </StackPanel>

                <!-- Opciones técnicas: solo en modo avanzado. -->
                <StackPanel Spacing="14" IsVisible="{Binding !IsSimpleMode}">
                  <Separator Background="{DynamicResource DividerBrush}" Margin="0"/>
                  <TextBlock Classes="overline" Text="{Binding LabelOptions}"/>

                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="{Binding LabelCompression}"/>
                    <ComboBox ItemsSource="{Binding AvailableLevels}"
                              SelectedItem="{Binding SelectedCompression}"
                              HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="{Binding LabelHashes}"/>
                    <WrapPanel Orientation="Horizontal">
                      <CheckBox Content="MD5" IsChecked="{Binding UseMd5}" Margin="0,0,14,0"/>
                      <CheckBox Content="SHA-1" IsChecked="{Binding UseSha1}" Margin="0,0,14,0"/>
                      <CheckBox Content="SHA-256" IsChecked="{Binding UseSha256}" Margin="0,0,14,0"/>
                      <CheckBox Content="SHA-512" IsChecked="{Binding UseSha512}"/>
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Spacing="8">
                    <CheckBox Content="{Binding LabelSplit}" IsChecked="{Binding IsSplitEnabled}"/>
                    <StackPanel Spacing="8" IsVisible="{Binding IsSplitEnabled}" Margin="28,0,0,0">
                      <TextBlock Classes="label" Text="{Binding LabelSplitSize}"/>
                      <ComboBox ItemsSource="{Binding AvailableSplitSizes}"
                                SelectedItem="{Binding SelectedSplitSize}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Text="{Binding CustomSplitMb}" Watermark="{Binding LabelSplitCustom}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <StackPanel Classes="stepHeader">
                  <Border Classes="step"><TextBlock Text="3"/></Border>
                  <TextBlock Classes="h2" Text="{Binding LabelStepWhere}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Classes="label" Text="{Binding LabelOutput}"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Classes="mono" Text="{Binding OutputPath}"/>
                  <Button Grid.Column="1" Classes="icon" Click="OnBrowseOutputClick" Margin="8,0,0,0"
                          ToolTip.Tip="{Binding LabelOutput}">
                    <Viewbox Width="20" Height="20"><Path Classes="icon" Data="{StaticResource IconFolder}"/></Viewbox>
                  </Button>
                </Grid>
                <TextBlock Classes="hint" Text="{Binding OutputHint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Panel>

  <UserControl.Styles>
    <Style Selector="StackPanel.stepHeader">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Spacing" Value="10"/>
    </Style>
    <Style Selector="Border.segmentTrack">
      <Setter Property="Background" Value="{DynamicResource SegmentTrackBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <Style Selector="RadioButton:checked Path.profileIcon">
      <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}"/>
    </Style>
  </UserControl.Styles>
</UserControl>
