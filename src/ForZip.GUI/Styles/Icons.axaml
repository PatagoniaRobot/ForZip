<!--
  Iconografía (propuesta visual 2026-10-17). Familia de línea: un solo trazo de 1,75 sobre
  una grilla de 24 x 24, puntas y uniones redondeadas, sin relleno. Cada ícono es una
  geometría que se pinta con el pincel que corresponda (estilo Path.icon en App.axaml), así
  que sirve igual en el tema claro y en el oscuro.

  Se muestran dentro de un Viewbox, que escala el trazo junto con la forma. Los
  rectángulos y círculos van como arcos porque Avalonia no admite otra cosa en un path.
  Los puntos (la "i", el signo de advertencia) son segmentos de largo casi cero: con la
  punta redondeada se dibujan como un punto.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Marca: el paquete con la tilde de verificado -->
  <StreamGeometry x:Key="IconBrand">M3,7.5 L12,3 L21,7.5 L12,12 Z M3,7.5 V16.5 L12,21 L21,16.5 V7.5 M8.5,13.5 L11,16 L15.5,11.5</StreamGeometry>

  <!-- Secciones -->
  <StreamGeometry x:Key="IconHome">M4,11 L12,4 L20,11 M6,10 V20 H18 V10</StreamGeometry>
  <StreamGeometry x:Key="IconPackage">M3,7.5 L12,3 L21,7.5 L12,12 Z M3,7.5 V16.5 L12,21 L21,16.5 V7.5 M12,12 V21</StreamGeometry>
  <StreamGeometry x:Key="IconExtract">M4,10 V17.5 L12,21 L20,17.5 V10 M4,10 L7,8.6 M20,10 L17,8.6 M12,15 V3 M8.5,6.5 L12,3 L15.5,6.5</StreamGeometry>
  <StreamGeometry x:Key="IconVerify">M12,3 L4.5,6 V11.5 C4.5,16.1 7.7,19.9 12,21 C16.3,19.9 19.5,16.1 19.5,11.5 V6 Z M8.8,12 L11.1,14.3 L15.5,9.7</StreamGeometry>
  <StreamGeometry x:Key="IconKey">M4,15 A4,4 0 1 1 12,15 A4,4 0 1 1 4,15 Z M10.8,12.2 L19.8,3.2 M16.5,6.5 L19.5,9.5 M14.2,8.8 L16.2,10.8</StreamGeometry>
  <StreamGeometry x:Key="IconHashBatch">M5,9 H19 M5,15 H19 M10,4 L8,20 M16,4 L14,20</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M4,6 H13 M17,6 H20 M4,12 H7 M11,12 H20 M4,18 H15 M19,18 H20 M13,6 A2,2 0 1 1 17,6 A2,2 0 1 1 13,6 Z M7,12 A2,2 0 1 1 11,12 A2,2 0 1 1 7,12 Z M15,18 A2,2 0 1 1 19,18 A2,2 0 1 1 15,18 Z</StreamGeometry>
  <StreamGeometry x:Key="IconAbout">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,11 V16 M12,8 V8.01</StreamGeometry>

  <!-- Objetos -->
  <StreamGeometry x:Key="IconEnvelope">M5,5 H19 A2,2 0 0 1 21,7 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 V7 A2,2 0 0 1 5,5 Z M3.5,6.5 L12,12.5 L20.5,6.5 M15,16 A2.5,2.5 0 1 1 20,16 A2.5,2.5 0 1 1 15,16 Z</StreamGeometry>
  <StreamGeometry x:Key="IconLock">M7,11 H17 A2,2 0 0 1 19,13 V19 A2,2 0 0 1 17,21 H7 A2,2 0 0 1 5,19 V13 A2,2 0 0 1 7,11 Z M8,11 V8 A4,4 0 0 1 16,8 V11</StreamGeometry>
  <StreamGeometry x:Key="IconReport">M14,3 H7 A2,2 0 0 0 5,5 V19 A2,2 0 0 0 7,21 H17 A2,2 0 0 0 19,19 V8 Z M14,3 V8 H19 M9,13 H15 M9,17 H15</StreamGeometry>
  <StreamGeometry x:Key="IconFile">M14,3 H7 A2,2 0 0 0 5,5 V19 A2,2 0 0 0 7,21 H17 A2,2 0 0 0 19,19 V8 Z M14,3 V8 H19</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z</StreamGeometry>
  <StreamGeometry x:Key="IconDrop">M12,15 V4 M7.5,8.5 L12,4 L16.5,8.5 M4,15 V18 A2,2 0 0 0 6,20 H18 A2,2 0 0 0 20,18 V15</StreamGeometry>
  <StreamGeometry x:Key="IconLog">M8,6 H20 M8,12 H20 M8,18 H20 M4,6 V6.01 M4,12 V12.01 M4,18 V18.01</StreamGeometry>

  <!-- Acciones -->
  <StreamGeometry x:Key="IconEye">M2.5,12 C2.5,12 6,5.5 12,5.5 C18,5.5 21.5,12 21.5,12 C21.5,12 18,18.5 12,18.5 C6,18.5 2.5,12 2.5,12 Z M9,12 A3,3 0 1 1 15,12 A3,3 0 1 1 9,12 Z</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M10,8 H18 A2,2 0 0 1 20,10 V18 A2,2 0 0 1 18,20 H10 A2,2 0 0 1 8,18 V10 A2,2 0 0 1 10,8 Z M16,8 V6 A2,2 0 0 0 14,4 H6 A2,2 0 0 0 4,6 V14 A2,2 0 0 0 6,16 H8</StreamGeometry>
  <StreamGeometry x:Key="IconArrowRight">M5,12 H19 M13,6 L19,12 L13,18</StreamGeometry>
  <StreamGeometry x:Key="IconPopOut">M14,4 H20 V10 M20,4 L11,13 M18,14 V18 A2,2 0 0 1 16,20 H6 A2,2 0 0 1 4,18 V8 A2,2 0 0 1 6,6 H10</StreamGeometry>
  <StreamGeometry x:Key="IconSave">M12,4 V15 M7.5,10.5 L12,15 L16.5,10.5 M4,15 V18 A2,2 0 0 0 6,20 H18 A2,2 0 0 0 20,18 V15</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>

  <!-- Estados -->
  <StreamGeometry x:Key="IconCheck">M5,12.5 L9.5,17 L19,7.5</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">M12,4 L2.5,20 H21.5 Z M12,10 V14.5 M12,17.5 V17.51</StreamGeometry>
  <StreamGeometry x:Key="IconExclamation">M12,7 V13 M12,17 V17.01</StreamGeometry>
  <StreamGeometry x:Key="IconCross">M7,7 L17,17 M17,7 L7,17</StreamGeometry>

</ResourceDictionary>
